# Copy to .env.local for local dev. On Vercel, set these under
# Project Settings → Environment Variables instead of committing them.

# Optional — without a key the app runs fully offline (heuristic
# interpreter, template explanations, BM25 retrieval).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# "lexical" | "embedding" (embedding falls back to lexical without a key)
RETRIEVER=lexical

# "local" | "firebase" (firebase adapter is a stub)
FILM_STORE=local

# Optional — absolute site URL for Open Graph metadata. On Vercel this
# defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
